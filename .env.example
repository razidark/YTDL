# YTDL Environment Variables

## Development

PORT=3000
LOG_LEVEL=info
MAX_FILE_SIZE=100
TEMP_DIR=./temp
NODE_ENV=development

## Production

PORT=3000
LOG_LEVEL=info
MAX_FILE_SIZE=100
TEMP_DIR=./temp
NODE_ENV=production

## Security

# Maximum download file size in MB (default: 100)
MAX_FILE_SIZE=100

# Temporary directory for downloads
TEMP_DIR=./temp

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Node environment
NODE_ENV=development
